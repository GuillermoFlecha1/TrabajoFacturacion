<?php

/**
 * @file
 * Funciones de instalación, actualización y desinstalación para el módulo Factura.
 */

/**
 * Implements hook_install().
 */
function factura_install() {
  // Se crea la tabla 'facturas' según el esquema definido.
  $schema = factura_schema();
  \Drupal::database()->schema()->createTable('facturas', $schema['facturas']);
}

/**
 * Implementa hook_schema().
 */
function factura_schema() {
  $schema['facturas'] = array(
    'description' => 'Tabla que almacena las facturas.',
    'fields' => array(
      'num_factura' => array(
        'description' => 'Número de Factura',
        'type' => 'serial',
        'not null' => TRUE,
      ),
      'uuid' => array(
        'description' => 'UUID de la factura',
        'type' => 'char',
        'length' => 36,
        'not null' => TRUE,
      ),
      'num_pedido' => array(
        'description' => 'Número de Pedido',
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
      ),
      'fecha_creacion' => array(
        'description' => 'Fecha de creación',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'fecha_vencimiento' => array(
        'description' => 'Fecha de vencimiento',
        'type' => 'datetime',
        'not null' => TRUE,
      ),
      'id_user' => array(
        'description' => 'ID del usuario relacionado',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'id_producto' => array(
        'description' => 'ID del producto relacionado',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'cantidad' => array(
        'description' => 'Cantidad de productos',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'total_precio' => array(
        'description' => 'Precio total de la factura',
        'type' => 'decimal',
        'precision' => 10,
        'scale' => 2,
        'not null' => TRUE,
      ),
    ),
    'primary key' => array('num_factura'),
    'foreign keys' => array(
      'id_user' => array(
        'table' => 'users',  // Asegúrate de que la tabla de usuarios se llama 'users' en Drupal
        'columns' => array('id_user' => 'uid'),
        'on delete' => 'CASCADE',
      ),
      'id_producto' => array(
        'table' => 'producto',  // Asegúrate de que la tabla de productos se llama 'producto'
        'columns' => array('id_producto' => 'id'),
        'on delete' => 'CASCADE',
      ),
    ),
    'indexes' => array(
      'idx_id_user' => array('id_user'),
      'idx_id_producto' => array('id_producto'),
    ),
  );

  return $schema;
}