<?php

/**
 * @file
 * Módulo personalizado para la facturación.
 */

/**
 * Implements hook_views_data().
 *
 * Exponemos las tablas "facturas" y "factura_productos" para que sean utilizadas por Views.
 */
function facturation_views_data() {
  $data = [];

  // Configuración para la tabla "facturas".
  $data['facturas']['table'] = [
    'group' => t('Facturas'),
    'base' => [
      'field' => 'id',
      'title' => t('Facturas'),
      'help' => t('Lista de facturas.'),
    ],
  ];

  // Campo: ID (NumFactura).
  $data['facturas']['id'] = [
    'title' => t('NumFactura'),
    'help' => t('Número de factura autoincremental.'),
    'field' => [
      'id' => 'numeric',
    ],
    'sort' => [
      'id' => 'standard',
    ],
    'filter' => [
      'id' => 'numeric',
    ],
  ];

  // Campo: Número de Pedido.
  $data['facturas']['num_pedido'] = [
    'title' => t('Número de Pedido'),
    'help' => t('Número de pedido único generado aleatoriamente.'),
    'field' => [
      'id' => 'standard',  // Se usa la presentación estándar (texto)
    ],
    'filter' => [
      'id' => 'string',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Campo: Fecha de Creación.
  // Se usa la columna real "fecha_creacion" de la base de datos.
  $data['facturas']['fecha_creacion'] = [
    'title' => t('Fecha de Creación'),
    'help' => t('La fecha en que se creó la factura.'),
    'field' => [
      'id' => 'date',
    ],
    'filter' => [
      'id' => 'date',
    ],
    'sort' => [
      'id' => 'date',
    ],
  ];

  // Campo: Fecha de Vencimiento.
  // Se usa la columna real "fecha_vencimiento" de la base de datos.
  $data['facturas']['fecha_vencimiento'] = [
    'title' => t('Fecha de Vencimiento'),
    'help' => t('La fecha de vencimiento de la factura.'),
    'field' => [
      'id' => 'date',
    ],
    'filter' => [
      'id' => 'date',
    ],
    'sort' => [
      'id' => 'date',
    ],
  ];

  // Campo: Total Final.
  $data['facturas']['total_final'] = [
    'title' => t('Total Final'),
    'help' => t('El total final de la factura.'),
    'field' => [
      'id' => 'numeric',
    ],
    'filter' => [
      'id' => 'numeric',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Campo: Estado.
  $data['facturas']['estado'] = [
    'title' => t('Estado'),
    'help' => t('El estado de la factura.'),
    'field' => [
      'id' => 'standard',
    ],
    'filter' => [
      'id' => 'string',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Campo: user_id con relación para mostrar el Cliente.
  $data['facturas']['user_id'] = [
    'title' => t('Cliente'),
    'help' => t('El cliente asociado a la factura.'),
    'relationship' => [
      'base' => 'users_field_data',
      'base field' => 'uid',
      'relationship field' => 'user_id',
      'title' => t('Cliente'),
      'id' => 'standard',
    ],
    'field' => [
      'id' => 'standard',
    ],
    'filter' => [
      'id' => 'numeric',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  return $data;
}

/**
 * Implements hook_views_pre_render().
 *
 * Recorre la vista y realiza conversiones:
 * - Convierte las fechas a timestamp.
 * - Procesa el número de pedido para agregar un prefijo:
 *     · Si el número es 0 se muestra "Número no disponible".
 *     · Si el número es distinto de 0, la primera aparición se le agrega "BI".
 *     · Si el mismo número se repite, a las siguientes se les agrega "BIV".
 * - Mapea el estado de la factura para obtener su representación textual.
 */
function facturation_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() == 'facturas') {
    // Define el mapeo para el campo 'estado'.
    $estado_map = [
      0 => t('Borrador'),
      1 => t('Finalizado'),
      2 => t('Rectificada'),
      3 => t('Rectificativa'),
    ];

    // Convertir las fechas si existen.
    foreach ($view->result as $row) {
      if (isset($row->facturas_fecha_creacion)) {
        $row->facturas_fecha_creacion = strtotime($row->facturas_fecha_creacion);
      }
      if (isset($row->facturas_fecha_vencimiento)) {
        $row->facturas_fecha_vencimiento = strtotime($row->facturas_fecha_vencimiento);
      }
    }

    // Usamos un arreglo para llevar el control de las apariciones del número de pedido.
    $seen = [];
    foreach ($view->result as $row) {
      // Procesar el mapeo del estado.
      if (isset($row->facturas_estado)) {
        $estado_value = $row->facturas_estado;
        $estado_display = isset($estado_map[$estado_value]) ? $estado_map[$estado_value] : $estado_value;
        $row->facturas_estado = $estado_display;
      }

      // Procesar el número de pedido.
      if (isset($row->facturas_num_pedido)) {
        // Quitar espacios en blanco y convertir a entero.
        $original_num = (int) trim($row->facturas_num_pedido);

        // Control de duplicados (para manejar las primeras y subsecuentes apariciones).
        if (!isset($seen[$original_num])) {
          $seen[$original_num] = 0;
        }
        $seen[$original_num]++;

        // La primera aparición se le antepone "BI", las siguientes "BIV".
        if ($seen[$original_num] == 1) {
          $row->facturas_num_pedido = 'BI' . $original_num;
        } else {
          $row->facturas_num_pedido = 'BIV' . $original_num;
        }
      }
    }
  }
}