<?php

use Drupal\Core\Url;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\Plugin\views\query\QueryPluginBase;

/**
 * Implements hook_views_data().
 */
function facturation_views_data() {
  $data['facturas'] = [
    'table' => [
      'group' => t('Facturas'),
      'base'  => [
        'field' => 'id',
        'title' => t('Facturas'),
        'help'  => t('Lista de facturas.'),
      ],
    ],
  ];

  // Campos estándar.
  $fields = [
    'id' => [
      'title' => t('NumFactura'),
      'help'  => t('Número de factura autoincremental.'),
      'field' => ['id' => 'numeric'],
      'filter'=> ['id' => 'numeric'],
      'sort'  => ['id' => 'standard'],
    ],
    'num_pedido' => [
      'title' => t('Número de Pedido'),
      'help'  => t('Número de pedido único generado aleatoriamente.'),
      'field' => ['id' => 'facturation_num_pedido'],
      'filter'=> ['id' => 'facturation_num_pedido_filter'],
      'sort'  => ['id' => 'standard'],
    ],
    'fecha_creacion' => [
      'title' => t('Fecha de Creación'),
      'help'  => t('La fecha en que se creó la factura.'),
      'field' => ['id' => 'date'],
      'filter'=> ['id' => 'date'],
      'sort'  => ['id' => 'date'],
    ],
    'fecha_vencimiento' => [
      'title' => t('Fecha de Vencimiento'),
      'help'  => t('La fecha de vencimiento de la factura.'),
      'field' => ['id' => 'date'],
      'filter'=> ['id' => 'date'],
      'sort'  => ['id' => 'date'],
    ],
    'total_final' => [
      'title' => t('Total Final'),
      'help'  => t('El total final de la factura.'),
      'field' => ['id' => 'numeric'],
      'filter'=> ['id' => 'numeric'],
      'sort'  => ['id' => 'standard'],
    ],
    'estado' => [
      'title' => t('Estado'),
      'help'  => t('El estado de la factura (Borrador, Finalizada, etc.).'),
      'field' => ['id' => 'standard'],
      'filter'=> ['id' => 'facturation_estado_filter'],
      'sort'  => ['id' => 'standard'],
    ],
    'user_id' => [
      'title'        => t('Cliente'),
      'help'         => t('El cliente asociado a la factura.'),
      'relationship' => [
        'base'             => 'users_field_data',
        'base field'       => 'uid',
        'relationship field'=> 'user_id',
        'title'            => t('Cliente'),
        'id'               => 'standard',
      ],
      'field'  => ['id' => 'facturation_user_field'],
      'filter' => ['id' => 'facturation_cliente_filter'],
      'sort'   => ['id' => 'standard'],
    ],
  ];

  foreach ($fields as $name => $info) {
    $data['facturas'][$name] = $info;
  }

  // Campo de acciones.
  $data['facturas']['acciones'] = [
    'title' => t('Acciones'),
    'help'  => t('Enlaces para acciones sobre la factura.'),
    'field' => [
      'id'             => 'facturation_actions',
      'click sortable' => FALSE,
    ],
  ];

  // Campos calculados.
  foreach (['total_importe', 'total_impuesto', 'tax_percentage'] as $name) {
    $data['facturas'][$name] = [
      'title'      => t(ucwords(str_replace('_', ' ', $name))),
      'help'       => t('Campo calculado «:name».', [':name' => $name]),
      'field'      => ['id' => 'facturation_calculated_field', 'click sortable' => FALSE],
      'real field' => 'id',
    ];
  }

  return $data;
}

/**
 * Implements hook_views_query_alter().
 */
function facturation_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'listafacturas' || !$query instanceof Sql) {
    return;
  }

  foreach ($query->fields as $alias => $fields) {
    foreach ($fields as $field_alias => $field) {
      if (preg_match('/^(total_importe|total_impuesto|tax_percentage)$/', $field_alias)) {
        unset($query->fields[$alias][$field_alias]);
      }
    }
    if (empty($query->fields[$alias])) {
      unset($query->fields[$alias]);
    }
  }
}

/**
 * Implements hook_views_pre_render().
 */
function facturation_views_pre_render(ViewExecutable $view) {
  if ($view->id() !== 'listafacturas') {
    return;
  }

  $estado_map = [
    0 => t('Borrador'),
    1 => t('Finalizada'),
    2 => t('Rectificada'),
    3 => t('Rectificativa'),
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('factura_producto');

  foreach ($view->result as $row) {
    // Formatear fechas.
    foreach (['fecha_creacion', 'fecha_vencimiento'] as $date_field) {
      $prop = "facturas_{$date_field}";
      if (!empty($row->$prop) && !is_numeric($row->$prop)) {
        $row->$prop = strtotime($row->$prop);
      }
    }

    // Mapear estado.
    if (is_numeric($row->facturas_estado)) {
      $row->facturas_estado = $estado_map[$row->facturas_estado] ?? $row->facturas_estado;
    }

    // Calcular totales.
    $total_importe = $total_impuesto = 0;
    $productos = $storage->loadByProperties(['factura_id' => $row->facturas_id]);

    foreach ($productos as $fp) {
      $cantidad    = $fp->cantidad->value;
      $producto    = $fp->producto_id->entity;
      $precio      = $producto->precio->value;
      $impuesto_pct = ($producto->hasField('impuesto_id') && ($imp = $producto->impuesto_id->entity))
        ? $imp->valor->value
        : 0;

      $importe          = $precio * $cantidad;
      $total_importe  += $importe;
      $total_impuesto += ($importe * $impuesto_pct) / 100;
    }

    $row->facturas_total_importe  = $total_importe;
    $row->facturas_total_impuesto = $total_impuesto;
    $row->facturas_tax_percentage = $total_importe ? ($total_impuesto * 100 / $total_importe) : 0;
  }

  // Agregar botón "Agregar Factura".
  $view->attachment_before += [
    'add_button' => [
      '#type'       => 'link',
      '#title'      => t('Agregar Factura'),
      '#url'        => Url::fromRoute('facturas.add_form'),
      '#attributes' => ['class' => ['button', 'button--primary']],
    ],
  ];
}
