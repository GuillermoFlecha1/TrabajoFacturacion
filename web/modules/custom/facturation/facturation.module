    ],
  ];
 
  return $data;
}
/**
 * Implements hook_views_pre_render().
 */
function facturation_views_pre_render(\Drupal\views\ViewExecutable $view) {
  // Verificamos que la vista que se está renderizando sea la que lista facturas.
  if ($view->id() == 'facturas') {
    // Convertimos las fechas a timestamp
    foreach ($view->result as $row) {
      if (isset($row->facturas_fecha_creacion)) {
        $row->facturas_fecha_creacion = strtotime($row->facturas_fecha_creacion);
      }
      if (isset($row->facturas_fecha_vencimiento)) {
        $row->facturas_fecha_vencimiento = strtotime($row->facturas_fecha_vencimiento);
      }
    }
    
    // Añadir el botón "Agregar Factura"
    if (!isset($view->attachment_before)) {
      $view->attachment_before = [];
    }
    
    $view->attachment_before['add_button'] = [
      '#type' => 'link',
      '#title' => t('Agregar Factura'),
      '#url' => Url::fromRoute('facturas.add_form'),
      '#attributes' => [
        'class' => ['button', 'button--primary'],
        'style' => 'margin-bottom: 10px; display: inline-block;',
      ],
    ];
  }
}

/**
 * Implements hook_entity_type_build().
 *
 * Permite alterar la definición de las entidades registradas, si es necesario.
 */
function facturation_entity_type_build(array &$entity_types) {
  // Ejemplo: modificar la definición de una entidad si fuese preciso.
}

/**
 * Implements hook_entity_view().
 *
 * Modifica la representación de las entidades en la vista.
 */
function facturation_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() === 'facturas') {
    // Agrega una clase CSS personalizada a la visualización de facturas.
    $build['#attributes']['class'][] = 'factura-view';
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Permite agregar variables globales a las plantillas de página.
 */
function facturation_preprocess_page(&$variables) {
  $variables['facturation_module_message'] = t('Bienvenido al módulo de Facturation.');
}