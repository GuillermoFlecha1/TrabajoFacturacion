    'title' => t('Fecha de Creación'),
    'help' => t('La fecha en que se creó la factura.'),
    'field' => [
      'id' => 'date',
    ],
    'filter' => [
      'id' => 'date',
    ],
    'sort' => [
      'id' => 'date',
    ],
  ];

  // Campo: Fecha de Vencimiento.
  // Se usa la columna real "fecha_vencimiento" de la base de datos.
  $data['facturas']['fecha_vencimiento'] = [
    'title' => t('Fecha de Vencimiento'),
    'help' => t('La fecha de vencimiento de la factura.'),
    'field' => [
      'id' => 'date',
    ],
    'filter' => [
      'id' => 'date',
    ],
    'sort' => [
      'id' => 'date',
    ],
  ];

  // Campo: Total Final.
  $data['facturas']['total_final'] = [
    'title' => t('Total Final'),
    'help' => t('El total final de la factura.'),
    'field' => [
      'id' => 'numeric',
    ],
    'filter' => [
      'id' => 'numeric',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Campo: Estado.
  $data['facturas']['estado'] = [
    'title' => t('Estado'),
    'help' => t('El estado de la factura (por ejemplo, Borrador, Rectificada, Finalizada).'),
    'field' => [
      'id' => 'standard',
    ],
    'filter' => [
      'id' => 'string',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Campo: user_id con relación para mostrar el Cliente.
  $data['facturas']['user_id'] = [
    'title' => t('Cliente'),
    'help' => t('El cliente asociado a la factura.'),
    'relationship' => [
      'base' => 'users_field_data',
      'base field' => 'uid',
      'relationship field' => 'user_id',
      'title' => t('Cliente'),
      'id' => 'standard',
    ],
    'field' => [
      'id' => 'standard',
    ],
    'filter' => [
      'id' => 'numeric',
    ],
    'sort' => [
      'id' => 'standard',
    ],
  ];

  // Configuración para la tabla "factura_productos".
  $data['factura_productos']['table'] = [
    'group' => t('Factura Productos'),
    'base' => [
      'field' => 'id',
      'title' => t('Factura Productos'),
      'help' => t('Lista de productos asociados a las facturas.'),
    ],
  ];

  // Campo: ID Relación en factura_productos.
  $data['factura_productos']['id'] = [
    'title' => t('ID Relación'),
    'help' => t('El ID único de la relación factura-producto.'),
    'field' => [
      'id' => 'numeric',
    ],
  ];

  // Campo: Relación de factura en factura_productos.
  $data['factura_productos']['factura_id'] = [
    'title' => t('Factura'),
    'help' => t('La factura asociada al producto.'),
    'relationship' => [
      'base' => 'facturas',
      'base field' => 'id',
      'relationship field' => 'factura_id',
      'title' => t('Factura'),
      'id' => 'standard',
    ],
    'field' => [
      'id' => 'numeric',
    ],
  ];

  // Campo: Producto.
  $data['factura_productos']['producto_id'] = [
