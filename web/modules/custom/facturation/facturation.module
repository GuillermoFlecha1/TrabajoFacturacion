/**
 * Implements hook_help().
 *
 * Proporciona una breve descripción y ayuda para el módulo.
 */
function facturation_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.facturation':
      return '<p>' . t('El módulo Facturation permite gestionar facturas y productos asociados, integrándolos como entidades de contenido en Drupal.') . '</p>';
  }
}
