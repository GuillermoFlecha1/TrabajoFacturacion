/**
 * Implements hook_views_pre_render().
 *
 * Recorre la vista y realiza las siguientes conversiones:
 * - Convierte las fechas a timestamp.
 * - Convierte el valor numérico del estado a su representación textual.
 * - Modifica el número de pedido según el estado:
 *     * Borrador: muestra "Número no disponible"
 *     * Finalizada o Rectificada: antepone "BI" al número de pedido.
 *     * Rectificativa: antepone "BIV" al número de pedido.
 */
function facturation_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() == 'facturas') {
    // Definir el mapeo de estados.
    $estado_map = [
      0 => t('Borrador'),
      1 => t('Finalizada'),
      2 => t('Rectificada'),
      3 => t('Rectificativa'),
    ];

    foreach ($view->result as $row) {
      // Convertir las fechas a timestamp si existen.
      if (isset($row->facturas_fecha_creacion)) {
        $row->facturas_fecha_creacion = strtotime($row->facturas_fecha_creacion);
      }
      if (isset($row->facturas_fecha_vencimiento)) {
        $row->facturas_fecha_vencimiento = strtotime($row->facturas_fecha_vencimiento);
      }

      // Procesar el campo estado y modificar el número de pedido según la lógica deseada.
      if (isset($row->facturas_estado)) {
        $estado_value = $row->facturas_estado;
        $estado_display = isset($estado_map[$estado_value]) ? $estado_map[$estado_value] : $estado_value;
        $row->facturas_estado = $estado_display;

        if (isset($row->facturas_num_pedido)) {
          $original_num = $row->facturas_num_pedido;

          // Aplicar la lógica:
          // - Si el estado es "Borrador": se muestra "Número no disponible"
          // - Si es "Finalizada" o "Rectificada": se antepone "BI"
          // - Si es "Rectificativa": se antepone "BIV"
          if ($estado_display === 0) {
            $row->facturas_num_pedido = 'Número no disponible';
          }
          elseif ($estado_display === 1 || $estado_display === 2) {
            $row->facturas_num_pedido = 'BI' . $original_num;
          }
          elseif ($estado_display === 3) {
            $row->facturas_num_pedido = 'BIV' . $original_num;
          }
          else {
            $row->facturas_num_pedido = $original_num;
          }
        }
      }
    }
  }
}

/**
 * Implements hook_entity_view().
 */
function facturation_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() === 'facturas') {
    $build['#attributes']['class'][] = 'factura-view';
  }
}