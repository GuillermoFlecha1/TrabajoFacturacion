/**
 * Implements hook_schema().
 */
function factura_install_schema() {
  $schema = [];

  // Definición de la tabla facturas
  $schema['facturas'] = [
    'description' => 'Tabla que almacena las facturas.',
    'fields' => [
      'id' => [
        'description' => 'Número de factura (ID autoincremental).',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uuid' => [
        'description' => 'UUID de la factura.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'fecha_creacion' => [
        'description' => 'Fecha de creación de la factura.',
        'type' => 'date',
        'not null' => TRUE,
      ],
      'num_pedido' => [
        'description' => 'Número de pedido único generado aleatoriamente.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
    ],

      'fecha_vencimiento' => [
        'description' => 'Fecha de vencimiento de la factura.',
        'type' => 'date',
        'not null' => TRUE,
      ],
      'user_id' => [
        'description' => 'ID del usuario asociado a la factura.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'total_final' => [
        'description' => 'Total final de la factura.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 2,
        'not null' => TRUE,
      ],
      'estado' => [
        'description' => 'Estado de la factura (Borrador, Finalizada).',
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
        'default' => 'Borrador',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
      'num_pedido' => ['num_pedido'],
    ],
    'indexes' => [
      'user_id' => ['user_id'],
    ],
    'foreign keys' => [
      'user_id' => [
        'table' => 'users_field_data',
        'columns' => ['user_id' => 'uid'],
      ],
    ],
  ];

  // Definición de la tabla factura_productos
  $schema['factura_productos'] = [
    'description' => 'Tabla que almacena los productos de cada factura.',
    'fields' => [
      'id' => [
        'description' => 'ID único de la relación.',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'factura_id' => [
        'description' => 'ID de la factura.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'producto_id' => [
        'description' => 'ID del producto.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'cantidad' => [
        'description' => 'Cantidad de este producto en la factura.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'factura_id' => ['factura_id'],
      'producto_id' => ['producto_id'],
    ],
    'foreign keys' => [
      'factura' => [
        'table' => 'facturas',
        'columns' => ['factura_id' => 'id'],
        'on_delete' => 'CASCADE',
      ],
      'producto' => [
        'table' => 'producto',
        'columns' => ['producto_id' => 'id'],
      ],
    ],
  ];

  return $schema;
}