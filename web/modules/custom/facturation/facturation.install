<?php

use Drupal\Core\Url;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_schema().
 */
function facturation_schema() {
  $schema = [];

  // Tabla principal: facturas.
  $schema['facturas'] = [
    'description' => 'Tabla que almacena las facturas.',
    'fields' => [
      'id'               => ['description' => 'ID autoincremental.',           'type' => 'serial',   'not null' => TRUE],
      'uuid'             => ['description' => 'UUID de la factura.',           'type' => 'varchar',  'length' => 128, 'not null' => TRUE],
      'fecha_creacion'   => ['description' => 'Timestamp creación.',           'type' => 'int',      'not null' => TRUE],
      'num_pedido'       => ['description' => 'Número de pedido.',             'type' => 'int',      'not null' => TRUE],
      'fecha_vencimiento'=> ['description' => 'Timestamp vencimiento.',        'type' => 'int',      'not null' => TRUE],
      'user_id'          => ['description' => 'ID usuario.',                   'type' => 'int',      'not null' => TRUE],
      'total_final'      => ['description' => 'Total final.',                  'type' => 'numeric',  'precision' => 10, 'scale' => 2, 'not null' => TRUE],
      'estado'           => ['description' => 'Estado.',                       'type' => 'varchar',  'length' => 50, 'not null' => TRUE, 'default' => 'Borrador'],
    ],
    'primary key' => ['id'],
    'unique keys' => ['uuid' => ['uuid'], 'num_pedido' => ['num_pedido']],
    'indexes' => ['user_id' => ['user_id']],
    'foreign keys' => [
      'user_fk' => [
        'table'   => 'users_field_data',
        'columns' => ['user_id' => 'uid'],
      ],
    ],
  ];

  // Tabla secundaria: factura_productos.
  $schema['factura_productos'] = [
    'description' => 'Productos por factura.',
    'fields' => [
      'id'         => ['description' => 'ID relación.',   'type' => 'serial', 'not null' => TRUE],
      'factura_id' => ['description' => 'ID factura.',    'type' => 'int',    'not null' => TRUE],
      'producto_id'=> ['description' => 'ID producto.',   'type' => 'int',    'not null' => TRUE],
      'cantidad'   => ['description' => 'Cantidad.',      'type' => 'int',    'not null' => TRUE, 'default' => 1],
    ],
    'primary key' => ['id'],
    'indexes' => ['factura_id' => ['factura_id'], 'producto_id' => ['producto_id']],
    'foreign keys' => [
      'factura_fk' => [
        'table'     => 'facturas',
        'columns'   => ['factura_id' => 'id'],
        'on_delete' => 'CASCADE',
      ],
      'producto_fk' => [
        'table'     => 'producto',
        'columns'   => ['producto_id' => 'id'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function facturation_install() {
  if (\Drupal::moduleHandler()->moduleExists('views')) {
    facturation_create_default_view();
  }
}

/**
 * Creates default 'listafacturas' view if not exists.
 */
function facturation_create_default_view() {
  $storage = \Drupal::entityTypeManager()->getStorage('view');
  if ($storage->load('listafacturas')) {
    return;
  }

  $base_fields = ['id', 'num_pedido', 'fecha_creacion', 'fecha_vencimiento', 'user_id', 'total_final', 'estado', 'acciones'];
  $field_defs = [];
  foreach ($base_fields as $field) {
    $field_defs[$field] = [
      'id'       => $field,
      'table'    => 'facturas',
      'field'    => $field,
      'label'    => match ($field) {
        'id' => 'NumFactura',
        'num_pedido' => 'Número de Pedido',
        'fecha_creacion' => 'Fecha de Creación',
        'fecha_vencimiento' => 'Fecha de Vencimiento',
        'user_id' => 'Cliente',
        'total_final' => 'Total Final',
        'estado' => 'Estado',
        'acciones' => 'Acciones',
      },
      'exclude'  => FALSE,
      'plugin_id'=> match ($field) {
        'fecha_creacion', 'fecha_vencimiento' => 'date',
        'num_pedido' => 'facturation_num_pedido',
        'user_id' => 'facturation_user_field',
        'acciones' => 'facturation_actions',
        default => 'numeric',
      },
    ];
    if (in_array($field, ['fecha_creacion', 'fecha_vencimiento'])) {
      $field_defs[$field]['settings'] = [
        'date_format' => 'custom',
        'custom_date_format' => 'Y/m/d',
        'timezone' => '',
      ];
    }
    if ($field === 'total_final') {
      $field_defs[$field]['precision'] = 2;
      $field_defs[$field]['settings'] = ['suffix' => ' €'];
    }
  }

  $view = $storage->create([
    'id' => 'listafacturas',
    'label' => 'Lista de Facturas',
    'description' => 'Listado de todas las facturas.',
    'tag' => 'facturation',
    'base_table' => 'facturas',
    'core' => '11.x',
    'status' => TRUE,
    'display' => [
      'default' => [
        'display_plugin' => 'default',
        'id' => 'default',
        'display_title' => 'Vista por defecto',
        'display_options' => [
          'title' => 'Lista de Facturas',
          'style' => ['type' => 'table', 'options' => ['columns' => array_combine($base_fields, $base_fields)]],
          'row' => ['type' => 'fields'],
          'header' => ['area' => ['plugin_id' => 'text', 'settings' => ['text' => '<a href="/admin/facturas/add" class="button button--primary" style="margin-bottom:10px; display:inline-block;">Agregar Factura</a>']]],
          'fields' => $field_defs,
          'sorts' => ['id' => ['id' => 'id', 'table' => 'facturas', 'field' => 'id', 'order' => 'DESC', 'plugin_id' => 'standard']],
          'pager' => ['type' => 'full', 'options' => ['items_per_page' => 25]],
          'cache' => ['type' => 'none'],
          'empty' => ['area_text_custom' => ['plugin_id' => 'text_custom', 'settings' => ['content' => 'No hay facturas disponibles.']]],
        ],
      ],
      'page_1' => [
        'display_plugin' => 'page',
        'id' => 'page_1',
        'display_title' => 'Página',
        'display_options' => ['path' => 'listafacturas', 'menu' => ['type' => 'normal', 'title' => 'Facturas', 'name' => 'main']],
      ],
    ],
  ]);

  $view->save();
  \Drupal::messenger()->addStatus(('Vista "Lista de Facturas" creada.'));
}
