              'table' => 'facturas',
              'field' => 'id',
              'order' => 'DESC',
              'plugin_id' => 'standard',
            ],
          ],
          // Paginador.
          'pager' => [
            'type' => 'full',
            'options' => [
              'items_per_page' => 25,
              'offset' => 0,
            ],
          ],
          // Configuración de la opción de caché: ninguno.
          'cache' => [
            'type' => 'none',
          ],
          // Área empty para cuando no existan resultados.
          'empty' => [
            'area_text_custom' => [
              'id' => 'area_text_custom',
              'table' => 'views',
              'field' => 'area_text_custom',
              'relationship' => 'none',
              'group_type' => 'group',
              'admin_label' => '',
              'empty' => TRUE,
              'content' => 'No hay facturas disponibles.',
              'plugin_id' => 'text_custom',
            ],
          ],
        ],
      ],
      // Display "page_1": página donde se muestra la vista.
      'page_1' => [
        'display_plugin' => 'page',
        'id' => 'page_1',
        'display_title' => 'Página',
        'position' => 1,
        'display_options' => [
          'path' => 'listafacturas',
          'menu' => [
            'type' => 'normal',
            'title' => 'Facturas',
            'description' => 'Administrar facturas',
            'weight' => 0,
            'name' => 'main',
            'context' => 0,
          ],
        ],
      ],
    ],
  ];

  // Crear y guardar la vista.
  $view = $view_storage->create($view_config);
  $view->save();

  \Drupal::messenger()->addStatus(t('Se ha creado la vista "Lista de Facturas".'));
}