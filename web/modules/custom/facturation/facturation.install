<?php

use Drupal\Core\Url;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_schema().
 */
function factura_install_schema() {
  $schema = [];

  // Definición de la tabla facturas.
  $schema['facturas'] = [
    'description' => 'Tabla que almacena las facturas.',
    'fields' => [
      'id' => [
        'description' => 'Número de factura (ID autoincremental).',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uuid' => [
        'description' => 'UUID de la factura.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'fecha_creacion' => [
        'description' => 'Fecha de creación de la factura (timestamp).',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'num_pedido' => [
        'description' => 'Número de pedido único generado aleatoriamente.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'fecha_vencimiento' => [
        'description' => 'Fecha de vencimiento de la factura (timestamp).',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'user_id' => [
        'description' => 'ID del usuario asociado a la factura.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'total_final' => [
        'description' => 'Total final de la factura.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 2,
        'not null' => TRUE,
      ],
      'estado' => [
        'description' => 'Estado de la factura (Borrador, Finalizada).',
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
        'default' => 'Borrador',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
      'num_pedido' => ['num_pedido'],
    ],
    'indexes' => [
      'user_id' => ['user_id'],
    ],
    'foreign keys' => [
      'user_id' => [
        'table' => 'users_field_data',
        'columns' => ['user_id' => 'uid'],
      ],
    ],
  ];

  // Definición de la tabla factura_productos. (Sin cambios)
  $schema['factura_productos'] = [
    'description' => 'Tabla que almacena los productos de cada factura.',
    'fields' => [
      'id' => [
        'description' => 'ID único de la relación.',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'factura_id' => [
        'description' => 'ID de la factura.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'producto_id' => [
        'description' => 'ID del producto.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'cantidad' => [
        'description' => 'Cantidad de este producto en la factura.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'factura_id' => ['factura_id'],
      'producto_id' => ['producto_id'],
    ],
    'foreign keys' => [
      'factura' => [
        'table' => 'facturas',
        'columns' => ['factura_id' => 'id'],
        'on_delete' => 'CASCADE',
      ],
      'producto' => [
        'table' => 'producto',
        'columns' => ['producto_id' => 'id'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function facturation_install() {
  // Si el módulo Views está activo, se crea la vista por defecto.
  if (\Drupal::moduleHandler()->moduleExists('views')) {
    _facturation_create_default_views();
  }
}
/**
 * Crea la vista por defecto para el módulo Facturation.
 */
function _facturation_create_default_views() {
  $view_storage = \Drupal::entityTypeManager()->getStorage('view');

  // Verificar si la vista ya existe.
  $view_exists = $view_storage->load('listafacturas');
  if ($view_exists) {
    return;
  }

  // Configuración de la vista.
  $view_config = [
    'id' => 'listafacturas',
    'label' => 'Lista de Facturas',
    'description' => 'Vista que muestra el listado de todas las facturas.',
    'tag' => 'facturation',
    'base_table' => 'facturas',
    'base_field' => 'id',
    'core' => '11.x',
    'status' => TRUE,
    'display' => [
      // Display "default": configuración base.
      'default' => [
        'display_plugin' => 'default',
        'id' => 'default',
        'display_title' => 'Vista por defecto',
        'position' => 0,
        'display_options' => [
          'title' => 'Lista de Facturas',
          'use_more' => FALSE,
          'style' => [
            'type' => 'table',
            'options' => [
              'hide_empty' => FALSE,
              'columns' => [
                'id' => 'id',
                'num_pedido' => 'num_pedido',
                'fecha_creacion' => 'fecha_creacion',
                'fecha_vencimiento' => 'fecha_vencimiento',
                'user_id' => 'user_id',
                'total_final' => 'total_final',
                'estado' => 'estado',
                'acciones' => 'acciones',
              ],
              'info' => [
                'id' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'num_pedido' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'fecha_creacion' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'desc',
                ],
                'fecha_vencimiento' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'user_id' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'total_final' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'estado' => [
                  'sortable' => TRUE,
                  'default_sort_order' => 'asc',
                ],
                'acciones' => [
                  'sortable' => FALSE,
                ],
              ],
            ],
          ],
          'row' => [
            'type' => 'fields',
          ],
          // Header que muestra el botón "Agregar Factura".
          'header' => [
            'area' => [
              'id' => 'area',
              'table' => 'views',
              'field' => 'area',
              'relationship' => 'none',
              'group_type' => 'group',
              'admin_label' => '',
              'empty' => TRUE,
              'tokenize' => FALSE,
              'settings' => [
                'text' => '<a href="/admin/facturas/add" class="button button--primary" style="margin-bottom: 10px; display: inline-block;">Agregar Factura</a>',
              ],
              'plugin_id' => 'text',
            ],
          ],
          // Definición de campos.
          'fields' => [
            'id' => [
              'id' => 'id',
              'table' => 'facturas',
              'field' => 'id',
              'label' => 'NumFactura',
              'exclude' => FALSE,
              'plugin_id' => 'numeric',
            ],
            'num_pedido' => [
              'id' => 'num_pedido',
              'table' => 'facturas',
              'field' => 'num_pedido',
              'label' => 'Número de Pedido',
              'exclude' => FALSE,
              'plugin_id' => 'facturation_num_pedido',
            ],
            'fecha_creacion' => [
              'id' => 'fecha_creacion',
              'table' => 'facturas',
              'field' => 'fecha_creacion',
              'label' => 'Fecha de Creación',
              'exclude' => FALSE,
              'plugin_id' => 'date',
              'settings' => [
                'date_format' => 'custom',
                // Formato que muestra solo año/mes/día sin hora.
                'custom_date_format' => 'Y/m/d',
                'timezone' => '',
              ],
            ],
            'fecha_vencimiento' => [
              'id' => 'fecha_vencimiento',
              'table' => 'facturas',
              'field' => 'fecha_vencimiento',
              'label' => 'Fecha de Vencimiento',
              'exclude' => FALSE,
              'plugin_id' => 'date',
              'settings' => [
                'date_format' => 'custom',
                // Formato que muestra solo año/mes/día sin hora.
                'custom_date_format' => 'Y/m/d',
                'timezone' => '',
              ],
            ],
            'user_id' => [
              'id' => 'user_id',
              'table' => 'facturas',
              'field' => 'user_id',
              'label' => 'Cliente',
              'exclude' => FALSE,
              'plugin_id' => 'facturation_user_field',
            ],
            'total_final' => [
              'id' => 'total_final',
              'table' => 'facturas',
              'field' => 'total_final',
              'label' => 'Total Final',
              'exclude' => FALSE,
              'precision' => 2,
              'plugin_id' => 'numeric',
              'settings' => [
                // Se añade el sufijo " €" al valor.
                'suffix' => ' €',
              ],
            ],
            'estado' => [
              'id' => 'estado',
              'table' => 'facturas',
              'field' => 'estado',
              'label' => 'Estado',
              'exclude' => FALSE,
              'plugin_id' => 'standard',
            ],
            'acciones' => [
              'id' => 'acciones',
              'table' => 'facturas',
              'field' => 'acciones',
              'label' => 'Acciones',
              'exclude' => FALSE,
              'plugin_id' => 'facturation_actions',
            ],
          ],
          // Configuración de sorts.
          'sorts' => [
            'id' => [
