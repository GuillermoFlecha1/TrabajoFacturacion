<?php

use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function tooltip_views_pre_render(ViewExecutable $view) {
  if ($view->id() === 'listafacturas') {
    // Tippy
    $view->element['#attached']['library'][] = 'tooltip/tooltip';
    // Keyboard shortcuts
    $view->element['#attached']['library'][] = 'tooltip/keyboard';
  }
}
